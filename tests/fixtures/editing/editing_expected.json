              "code": "FORMAT_COLLAPSED"
            }
          ],
          "preservedRaw": [
            "<hp:run charPrIDRef=\"1\"><hp:t></hp:t></hp:run>"
          ],
          "note": "run0 'c'|run1 'def'|run2 'gh' 를 지우고 첫 조각(run0)에 X 를 넣는다. 빈 hp:t 와 run 은 유지."
        },
        {
          "op": "text.replace",
          "target": {
            "entry": "Contents/section0.xml",
            "paragraph": 0
          },
          "args": {
            "range": [
              3,
